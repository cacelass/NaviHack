# TinyVigo — snapshot publisher (D-01). Intervalos medidos en D-00
# (vault/01_PROYECTO/fuentes_datos.md, A7). Instalar: crontab deploy/snapshot.cron
# (ajusta la ruta del checkout).
CRON_TZ=Europe/Madrid
# parkings: el origen publica cada 2 min en minuto par +4 s → leemos a los +30 s
*/2 * * * *  sleep 30; cd $HOME/NaviHack && python3 scripts/snapshot.py parkings >/dev/null
# agenda: se publica ~07:05 Madrid → 07:30 y reintento 09:00
30 7 * * *   cd $HOME/NaviHack && python3 scripts/snapshot.py agenda >/dev/null
0 9 * * *    cd $HOME/NaviHack && python3 scripts/snapshot.py agenda >/dev/null
# tiempo: Open-Meteo actualiza cada 15 min → cada 30
*/30 * * * *  cd $HOME/NaviHack && python3 scripts/snapshot.py weather >/dev/null
35 7 * * *   cd $HOME/NaviHack && python3 scripts/agenda.py >/dev/null
5 9 * * *    cd $HOME/NaviHack && python3 scripts/agenda.py >/dev/null
*/2 * * * *  sleep 40; cd $HOME/NaviHack && python3 -m scripts.parkings >/dev/null
# GTFS Vitrasa: el Concello lo republica a diario (~13:05 UTC)
30 14 * * *  cd $HOME/NaviHack && python3 -m scripts.gtfs_vitrasa >/dev/null
# Renfe GTFS AV/LD/MD: se republica ~00:08 UTC
0 3 * * *    cd $HOME/NaviHack && python3 -m scripts.gtfs_renfe >/dev/null
40 7 * * *   cd $HOME/NaviHack && python3 -m scripts.venues >/dev/null
# R-05: re-verificación semanal de la capa navideña (lunes 06:00)
0 6 * * 1    cd $HOME/NaviHack && python3 -m scripts.reverify >/dev/null
# X-09: la capa de cámaras (posiciones/URLs) cambia poco: una vez al día
15 4 * * *   cd $HOME/NaviHack && python3 -m scripts.cameras >/dev/null
